{
  "name": "claude-delegate-mcp",
  "version": "2.9.4",
  "description": "MCP server for Claude Desktop that delegates tasks to a headless Claude Code CLI session, billed against your existing Claude subscription — no separate API key.",
  "type": "module",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test tests/**/*.test.js",
    "build:dashboard": "npm --prefix dashboard run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "claude",
    "claude-code",
    "claude-desktop",
    "anthropic",
    "delegation",
    "subagent"
  ],
  "homepage": "https://github.com/Ahmed-Eldamanhoury/Delegate-MCP#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahmed-Eldamanhoury/Delegate-MCP.git"
  },
  "bugs": {
    "url": "https://github.com/Ahmed-Eldamanhoury/Delegate-MCP/issues"
  },
  "license": "Apache-2.0",
  "author": "Delegate-MCP",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.23.8"
  }
}
